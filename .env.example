# Região AWS onde o Bedrock está habilitado
AWS_REGION=us-east-1
# Perfil do ~/.aws/credentials (opcional)
AWS_PROFILE=default

# Modelo rápido e barato: pesquisa, curadoria e organização
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Modelo forte: produção e revisão do conteúdo
BEDROCK_MODEL_STRONG=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Confira os IDs disponíveis na sua conta em:
# Console Bedrock > Model access / Cross-region inference
